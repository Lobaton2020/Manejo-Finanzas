DB_HOST=
DB_NAME=
DB_USER=
DB_PASWORD=
DB_PORT=3306
DB_DRIVER=mysql
DB_CHARSET=utf8

URL_EMAIL_NOTIFIER_MS=
DOMAIN_EMAIL=
# --- Integracion IA (MiniMax) para el modulo Suggested ---
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TIMEOUT=30
MINIMAX_THINKING=disabled
MINIMAX_MAX_TOKENS=4096

# --- Fallback de IA (Google Gemini) ---
# Se usa solo cuando MiniMax falla (sin saldo, caido, sin key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=40
GEMINI_MAX_TOKENS=4096
GEMINI_THINKING_BUDGET=0

# Usuario que recibe las sugerencias del webhook (sin auth, red privada)
SUGGESTION_USER_ID=1
