FROM php:8.2.31-apache

WORKDIR /var/www/html

RUN groupadd -g 1000 app \
    && useradd -u 1000 -g app -m -s /usr/sbin/nologin app \
    && docker-php-ext-install mysqli pdo pdo_mysql opcache \
    && a2enmod rewrite \
    && chown -R app:app /var/log/apache2 /var/run/apache2 /var/lock/apache2

COPY php.dev.ini "$PHP_INI_DIR/conf.d/zz-dev.ini"

ENV APACHE_RUN_USER=app \
    APACHE_RUN_GROUP=app